# Copy this file to .env and paste your personal MAI key below — the only thing to fill in.
# Mint it yourself at https://study.modernaipro.com/practice (it shows exactly once).
# A shared class token pinned in the cohort room on class days works in the same slot.
OPENAI_API_KEY=paste-your-mai_-key-here
# (the Practice page calls this MAI_API_KEY — either name works here)
# Preset to the class LLM proxy — leave as is.
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1

# Optional: Langfuse tracing for the RAG scripts. Both keys are needed — the
# public key alone cannot send traces. Omit them and tracing is simply off.
# Keys come from your Langfuse project under Settings -> API Keys.
#LANGFUSE_PUBLIC_KEY=pk-lf-...
#LANGFUSE_SECRET_KEY=sk-lf-...
# Note the name: the v4 SDK reads LANGFUSE_BASE_URL and ignores LANGFUSE_HOST,
# which older docs still show. Region must match the region the keys came from.
#LANGFUSE_BASE_URL=https://us.cloud.langfuse.com    # eu. for the EU region
